---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteNav from './sections/SiteNav.astro';
import Hero from './sections/Hero.astro';
import Experience from './sections/Experience.astro';
import Project from './sections/Project.astro';
import Stack from './sections/Stack.astro';
import Contact from './sections/Contact.astro';
import SiteFooter from './sections/SiteFooter.astro';
import DitherBand from './atoms/DitherBand.astro';
import { getDictionary, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getDictionary(locale);
---

<BaseLayout t={t} locale={locale}>
  <SiteNav t={t} locale={locale} />
  <DitherBand base="tile-1" check="black" />
  <main id="main">
    <Hero t={t} />
    <DitherBand base="parchment" check="tile-1" />
    <Experience t={t} />
    <DitherBand base="tile-1" check="parchment" />
    <Project t={t} />
    <DitherBand base="canvas" check="tile-1" />
    <Stack t={t} />
    <DitherBand base="tile-3" check="canvas" />
    <Contact t={t} />
  </main>
  <DitherBand base="parchment" check="tile-3" />
  <SiteFooter t={t} />
</BaseLayout>
