---
interface Props {
  onDark?: boolean;
  size?: 'default' | 'compact' | 'lead';
  constrained?: boolean;
}

const { onDark = false, size = 'default', constrained = false } = Astro.props;
---

<p class:list={['body-text', size, { 'on-dark': onDark, constrained }]}>
  <slot />
</p>

<style>
  .body-text {
    font-family: var(--font-body);
    line-height: 1.35;
    color: var(--color-ink-muted-80);
  }

  .body-text.on-dark {
    color: var(--color-body-muted);
  }

  .body-text.default {
    font-size: 20px;
  }

  .body-text.compact {
    font-size: 19px;
  }

  .body-text.lead {
    font-size: 21px;
    color: var(--color-on-dark);
  }

  .body-text.constrained {
    max-width: 760px;
  }

  @media (min-width: 1068px) {
    .body-text.default {
      font-size: 22px;
    }

    .body-text.compact {
      font-size: 21px;
    }

    .body-text.lead {
      font-size: 27px;
      line-height: 1.3;
    }
  }
</style>
