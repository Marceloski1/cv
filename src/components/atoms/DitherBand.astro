---
type Surface = 'black' | 'tile-1' | 'tile-3' | 'parchment' | 'canvas';

interface Props {
  base: Surface;
  check: Surface;
}

const SURFACES: Record<Surface, string> = {
  black: 'var(--surface-black)',
  'tile-1': 'var(--surface-tile-1)',
  'tile-3': 'var(--surface-tile-3)',
  parchment: 'var(--canvas-parchment)',
  canvas: 'var(--canvas)',
};

const { base, check } = Astro.props;
const style = `--dither-base:${SURFACES[base]};--dither-check:${SURFACES[check]}`;
---

<div class="dither-band" style={style} aria-hidden="true"></div>

<style>
  .dither-band {
    height: 10px;
    background-color: var(--dither-base);
    background-image: linear-gradient(
        45deg,
        var(--dither-check) 25%,
        transparent 25%,
        transparent 75%,
        var(--dither-check) 75%
      ),
      linear-gradient(
        45deg,
        var(--dither-check) 25%,
        transparent 25%,
        transparent 75%,
        var(--dither-check) 75%
      );
    background-size: 10px 10px;
    background-position:
      0 0,
      5px 5px;
  }
</style>
