---
import { isImageLogo, renderPixelLogo, type LogoName, type PixelPalette } from '../../lib/pixel-logo';
import { imageLogos } from '../../assets/logos';

interface Props {
  name: LogoName;
  size?: number;
  palette?: PixelPalette;
}

const { name, size = 16, palette } = Astro.props;
const isImage = isImageLogo(name);
const svg = isImage ? null : renderPixelLogo(name, size, palette);
---

{
  isImage ? (
    <img class="pixel-logo" src={imageLogos[name].src} width={size} height={size} alt="" decoding="async" />
  ) : (
    <span class="pixel-logo" aria-hidden="true" set:html={svg} />
  )
}

<style>
  .pixel-logo {
    display: block;
    flex-shrink: 0;
    line-height: 0;
  }
</style>
