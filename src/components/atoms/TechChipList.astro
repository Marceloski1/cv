---
import TechChip from './TechChip.astro';
import type { TechItem } from '../../data/cv';

interface Props {
  items: TechItem[];
  dark?: boolean;
  label: string;
}

const { items, dark = false, label } = Astro.props;
---

<ul class="tech-chip-list" aria-label={label}>
  {items.map((item) => <TechChip logo={item.logo} label={item.label} palette={item.palette} dark={dark} />)}
</ul>

<style>
  .tech-chip-list {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
</style>
