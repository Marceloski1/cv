---
import { sectionIds, shortName } from '../../data/cv';
import type { Dictionary } from '../../i18n/types';

interface Props {
  t: Dictionary;
}

const { t } = Astro.props;

const footerLinks = [
  { href: `#${sectionIds.experience}`, label: t.navExp },
  { href: `#${sectionIds.project}`, label: t.navProj },
  { href: `#${sectionIds.stack}`, label: t.navStack },
  { href: `#${sectionIds.contact}`, label: t.navContact },
];
---

<footer class="site-footer">
  <div class="tile-inner">
    <div class="footer-top">
      <div>
        <p class="footer-name">{shortName}</p>
        <p class="footer-location">{t.footerLocation}</p>
      </div>
      <ul class="footer-links">
        {
          footerLinks.map((link) => (
            <li>
              <a href={link.href}>{link.label}</a>
            </li>
          ))
        }
      </ul>
    </div>
    <div class="footer-rule"></div>
    <p class="footer-legal">{t.footerLegal}</p>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--canvas-parchment);
    padding: 36px var(--tile-pad-inline);
  }

  .footer-top {
    display: flex;
    flex-direction: column;
    gap: 20px;
    margin-bottom: 20px;
  }

  .footer-name {
    font-family: var(--font-pixel);
    font-size: 10px;
    line-height: 1.7;
    color: var(--color-ink);
    margin-bottom: 12px;
  }

  .footer-location {
    font-family: var(--font-label);
    font-size: 11px;
    color: var(--color-ink-muted-48);
  }

  .footer-links {
    display: flex;
    flex-wrap: wrap;
    gap: 26px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .footer-links a {
    font-family: var(--font-label);
    font-size: 11px;
    color: var(--color-ink-muted-80);
  }

  .footer-links a:hover {
    color: var(--color-primary);
  }

  .footer-rule {
    height: 3px;
    background: var(--color-ink);
    margin-bottom: 18px;
  }

  .footer-legal {
    font-family: var(--font-label);
    font-size: 10px;
    color: var(--color-ink-muted-48);
  }

  @media (min-width: 1068px) {
    .site-footer {
      padding-top: 52px;
      padding-bottom: 52px;
    }

    .footer-top {
      flex-direction: row;
      align-items: flex-start;
      justify-content: space-between;
      gap: 40px;
      margin-bottom: 26px;
    }

    .footer-name {
      font-size: 12px;
    }

    .footer-location {
      font-size: 12px;
    }

    .footer-rule {
      margin-bottom: 20px;
    }

    .footer-legal {
      font-size: 11px;
    }
  }
</style>
