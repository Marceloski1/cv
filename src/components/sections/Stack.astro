---
import Kicker from '../atoms/Kicker.astro';
import SectionHeading from '../atoms/SectionHeading.astro';
import PixelBox from '../atoms/PixelBox.astro';
import PixelLogo from '../atoms/PixelLogo.astro';
import BodyText from '../atoms/BodyText.astro';
import { sectionIds, stackGrid } from '../../data/cv';
import type { Dictionary } from '../../i18n/types';

interface Props {
  t: Dictionary;
}

const { t } = Astro.props;
---

<section id={sectionIds.stack} class="tile tile-canvas" aria-labelledby="stack-heading">
  <div class="tile-inner">
    <Kicker>{t.stackKicker}</Kicker>
    <SectionHeading id="stack-heading">{t.stackHead}</SectionHeading>

    <ul class="stack-grid">
      {
        stackGrid.map((item) => (
          <li class="stack-cell">
            <PixelLogo name={item.logo} size={32} palette={item.palette} />
            <span class="stack-label">{item.label}</span>
          </li>
        ))
      }
    </ul>

    <div class="stack-meta">
      <PixelBox>
        <Kicker>{t.eduKicker}</Kicker>
        <h3 class="meta-title">{t.eduDegree}</h3>
        <BodyText size="compact">{t.eduSchool}</BodyText>
        <p class="meta-note">{t.eduYear}</p>
      </PixelBox>
      <PixelBox>
        <Kicker>{t.awardKicker}</Kicker>
        <h3 class="meta-title">{t.awardTitle}</h3>
        <BodyText size="compact">{t.awardWhere}</BodyText>
      </PixelBox>
    </div>
  </div>
</section>

<style>
  .stack-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 12px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .stack-cell {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    background: var(--canvas);
    border: 2px solid var(--color-ink);
    box-shadow: 3px 3px 0 var(--color-ink);
    padding: 14px 8px;
  }

  .stack-cell :global(svg) {
    width: 26px;
    height: 26px;
  }

  .stack-label {
    font-family: var(--font-label);
    font-size: 10px;
    color: var(--color-ink);
    text-align: center;
    line-height: 1.3;
  }

  .stack-meta {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 18px;
    margin-top: 34px;
  }

  .meta-title {
    font-family: var(--font-pixel);
    font-size: 11px;
    line-height: 1.6;
    color: var(--color-ink);
    margin-bottom: 12px;
  }

  .meta-note {
    font-family: var(--font-label);
    font-size: 10px;
    color: var(--color-ink-muted-48);
    margin-top: 12px;
  }

  @media (min-width: 640px) {
    .stack-grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  @media (min-width: 834px) {
    .stack-meta {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 26px;
    }
  }

  @media (min-width: 1068px) {
    .stack-grid {
      grid-template-columns: repeat(6, minmax(0, 1fr));
    }

    .stack-cell :global(svg) {
      width: 32px;
      height: 32px;
    }

    .stack-meta {
      margin-top: 44px;
    }

    .meta-title {
      font-size: 14px;
      margin-bottom: 14px;
    }

    .meta-note {
      font-size: 11px;
      margin-top: 14px;
    }
  }
</style>
